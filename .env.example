# Mapbox access token for the dashboard basemap.
#
# Next.js inlines NEXT_PUBLIC_* variables at BUILD time, so docker-compose
# passes this through `build.args` (see docker-compose.yml). Copy this file to
# a repo-root `.env` (gitignored) and put your real token here before running
# `docker compose build`.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
